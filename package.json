{
  "name": "lab-x-studio",
  "version": "1.0.0",
  "description": "Lab X — Professional Diagnostic Studio & Multi-Report Generator for PC",
  "main": "main.js",
  "author": "Krishna Diagnostic Laboratory <support@krishnalab.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.krishnalab.labx",
    "productName": "Lab-X-Studio",
    "compression": "maximum",
    "files": [
      "index.html",
      "main.js"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Krishna Diagnostic Laboratory <support@krishnalab.com>",
      "category": "Office",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lab X Studio"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
